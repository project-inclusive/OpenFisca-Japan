// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "OpenFisca-Japan",

  // Build context is the repo root (one level up from .devcontainer).
  "context": "..",
  "dockerFile": "./Dockerfile",
  "shutdownAction": "none",
  
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [30000, 50000],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "runArgs": ["--init"],

  // Bind the host Docker socket (docker-from-docker) plus per-agent config volumes.
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=openfisca-japan-claude,target=/home/user/.claude,type=volume",
    "source=openfisca-japan-codex,target=/home/user/.codex,type=volume",
    "source=openfisca-japan-copilot,target=/home/user/.copilot,type=volume"
  ],
  "overrideCommand": false,
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "containerEnv": {
    "COPILOT_HOME": "/home/user/.copilot",
    "LANG": "ja_JP.UTF-8",
    "LANGUAGE": "ja_JP:ja",
    "LC_CTYPE": "ja_JP.UTF-8"
  },

  "remoteUser": "user",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        // flake8/autopep8 config is authoritative in setup.cfg; the old
        // python.linting.*/python.formatting.* settings were removed from the
        // Python extension and are intentionally not duplicated here.
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        "wraith13.bracket-lens",
        "vscode-icons-team.vscode-icons",
        "oderwat.indent-rainbow",
        "mosapride.zenkaku",
        "ms-python.python",
        "ms-vsliveshare.vsliveshare",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "anthropic.claude-code",
        "github.copilot",
        "github.copilot-chat",
        "openai.chatgpt"        
      ]
    }
  }
}
