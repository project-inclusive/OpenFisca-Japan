// devcontainer.json の書式: https://aka.ms/devcontainer.json
{
  "name": "OpenFisca-Japan",

  // ビルドコンテキストはリポジトリのルート（.devcontainer の 1 つ上）
  "context": "..",
  "dockerFile": "./Dockerfile",
  // VS Code を閉じてもコンテナを停止しない（常駐。停止はユーザーが docker で明示的に行う）
  "shutdownAction": "none",

  // ポート公開は docker-compose が担う（ホストに 0.0.0.0 で publish）。
  // devcontainer 側で appPort を持つと 30000/50000 が競合するため設定しない。詳細: docs/devcontainer_note.md

  // features: 追加でインストールするツール群（共通ユーティリティ / GitHub CLI / Claude Code / GitHub Copilot CLI）
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    },
    // gh コマンド。post-create.sh の `gh copilot` 拡張インストールに必要。
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    // フロントエンド開発・各種 CLI 用。dashboard/Dockerfile (node:26.4-bullseye) とメジャーバージョンを合わせている。
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    }
  },

  // postCreateCommand: 作成時（初回）に一度だけ実行 / postStartCommand: 起動のたびに実行
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // --init: ゾンビプロセス回収のため tini を有効化
  "runArgs": ["--init"],

  // mounts: ホストの Docker ソケット(docker-from-docker)と、AI CLI 設定・git 設定用の名前付きボリューム。
  // 名前付きボリュームによりリビルドしてもログイン状態や git config が保持される。
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=openfisca-japan-claude,target=/home/user/.claude,type=volume",
    "source=openfisca-japan-codex,target=/home/user/.codex,type=volume",
    "source=openfisca-japan-copilot,target=/home/user/.copilot,type=volume",
    "source=openfisca-japan-gitconfig,target=/home/user/.config/git,type=volume"
  ],
  // overrideCommand: false = Dockerfile の CMD(sleep infinity)をそのまま使う（常駐させる）
  "overrideCommand": false,
  // remoteEnv: コンテナ内プロセスに渡す環境変数（ホスト側のワークスペースパス）
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  // containerEnv: コンテナ全体の環境変数。日本語ロケールで文字化けを防ぐ。
  "containerEnv": {
    "COPILOT_HOME": "/home/user/.copilot",
    "LANG": "ja_JP.UTF-8",
    "LANGUAGE": "ja_JP:ja",
    "LC_CTYPE": "ja_JP.UTF-8",
    // git config --global の読み書き先を永続化ボリューム上のファイルに固定する（既定の ~/.gitconfig だとリビルドで消える）
    "GIT_CONFIG_GLOBAL": "/home/user/.config/git/config"
  },

  // 非 root ユーザー user で接続（Dockerfile で作成）
  "remoteUser": "user",
  "customizations": {
    "vscode": {
      // VS Code の設定
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        // Wayland ソケットの自動マウントを無効化し、WSL 側の一時パス変動による
        // `no such file or directory` での起動失敗を防ぐ。
        "dev.containers.mountWaylandSocket": false,
        "remote.containers.mountWaylandSocket": false,
        // flake8/autopep8 の設定は setup.cfg を正とする。旧来の
        // python.linting.* / python.formatting.* は Python 拡張から削除済みのため、
        // ここでは重複して定義しない。
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      // 自動インストールする VS Code 拡張（日本語パック / Python / Docker / 各種 AI 支援 等）
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        "wraith13.bracket-lens",
        "vscode-icons-team.vscode-icons",
        "oderwat.indent-rainbow",
        "mosapride.zenkaku",
        "ms-python.python",
        "ms-vsliveshare.vsliveshare",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "anthropic.claude-code",
        "github.copilot",
        "openai.chatgpt"
      ]
    }
  }
}
